# Set default behavior to automatically normalize line endings
* text=auto

# Force specific files to have Unix line endings
*.py text eol=lf
*.ui text eol=lf
*.md text eol=lf

# Force specific files to have Windows line endings
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat certain files as binary (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
